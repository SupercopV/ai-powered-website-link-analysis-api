# Server Configuration
# Local default port is 4000; Render dynamically overrides PORT via $PORT
HOST=0.0.0.0
PORT=4000

# LLM Provider Configuration
# Supported options:
#   - groq      : Groq Cloud API (Primary Recommended: Ultra-low latency, JSON mode + Pydantic validation, openai/gpt-oss-20b)
#   - gemini    : Google Gemini API (Alternative: Free tier available on AI Studio, 1M context)
#   - openai    : OpenAI API (gpt-6-luna, pay-per-token)
#   - anthropic : Anthropic Claude API (claude-haiku-5-5, pay-per-token)
#   - mock      : Deterministic offline mode (extracts real site content, zero cost, no API key required)
LLM_PROVIDER=groq

# Groq Configuration (Primary Provider)
# Official Portal: https://console.groq.com/
# Model Docs: https://console.groq.com/docs/models
# Pricing: $0.075/1M input, $0.300/1M output for openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini Configuration (Optional alternative)
# An API key and eligible free-tier access are required from Google AI Studio: https://aistudio.google.com/
# Free-tier rate limits and quotas apply. Google may use free-tier prompts and responses to improve its products.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Configuration (Optional fallback)
# Pricing: $0.10/1M input, $0.50/1M output. Requires funded API key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# Anthropic Configuration (Optional fallback)
# Pricing: $0.10/1M input, $0.50/1M output (<=100k tokens). Requires funded API key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Security & Scraping Safeguards
REQUEST_TIMEOUT_SECONDS=15.0
MAX_CONTENT_LENGTH_BYTES=5242880
MAX_REDIRECTS=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (LinkAnalysisBot/1.0)

